# Copy to /etc/aurora/aurora.env and chmod 600.
# Never commit real credentials or the live authorization record.

AURORA_DIRECTOR_PROVIDER=router

NVIDIA_API_KEY=
# NVIDIA is Aurora's only external inference provider.


AURORA_INFERENCE_COST_POLICY=free_only
AURORA_FREE_MODEL_POLICY=config/free-model-policy.json
AURORA_MODEL_DISCOVERY_REFRESH_ENABLED=1
AURORA_MODEL_DISCOVERY_REFRESH_SECONDS=900
AURORA_PROVIDER_HEALTH_FAILURE_THRESHOLD=2
AURORA_PROVIDER_HEALTH_BASE_COOLDOWN_SECONDS=15
AURORA_PROVIDER_HEALTH_MAX_COOLDOWN_SECONDS=300

# Aurora discovers the currently available NVIDIA-served models dynamically
# when a Director failover to NVIDIA is actually required.

AURORA_EGRESS_PROXY_HOST=
AURORA_EGRESS_PROXY_PORT=3128
AURORA_RESEARCH_DISCOVERY_ENDPOINT=

AURORA_DASHBOARD_HOST=127.0.0.1
AURORA_DASHBOARD_PORT=8787
# Required only for a non-loopback dashboard bind.
AURORA_DASHBOARD_API_TOKEN=

AURORA_WORKER_ID=aurora-prod-01
AURORA_WORKER_CONCURRENCY=4
AURORA_WORKSPACE_ROOT=.aurora-runtime

# Set this to the exact verified main commit deployed on the host.
AURORA_CANONICAL_COMMIT=

AURORA_INFERENCE_POLICY=config/inference-policy.json
AURORA_AUTONOMY_POLICY=config/autonomy-policy.json
AURORA_TOOL_REGISTRY=config/tool-registry.json
AURORA_NETWORK_POLICY=config/network-policy.json
AURORA_ORGANIZATION_POLICY=config/organization.json
AURORA_SKILLS_POLICY=config/skills.json
AURORA_TASK_DB=.aurora-runtime/tasks.db
