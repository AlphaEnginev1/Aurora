+    def stalled_missions(
+        self, *, idle_seconds: float, now: datetime | None = None
+    ) -> tuple[dict[str, Any], ...]:
+        """Misiones con tareas pending/running (ultima fase) sin actividad reciente.
+
+        La actividad es el maximo entre ``tasks.updated_at`` (que ``renew_lease``
+        actualiza) y la fecha del ultimo evento de la mision.
+        """
+        if idle_seconds <= 0:
+            raise TaskStoreError("idle_seconds must be positive")
+        now = now or datetime.now(timezone.utc)
+        stalled: list[dict[str, Any]] = []
+        with self._connect() as db:
+            rows = db.execute(
+                """
+                SELECT t.mission_id AS mission_id,
+                       MAX(t.updated_at) AS last_task_at,
+                       SUM(CASE WHEN t.status = 'running' THEN 1 ELSE 0 END) AS running,
+                       SUM(CASE WHEN t.status = 'pending' THEN 1 ELSE 0 END) AS pending
+                FROM tasks t
+                WHERE t.phase = (SELECT MAX(phase) FROM tasks WHERE mission_id = t.mission_id)
+                GROUP BY t.mission_id
+                HAVING running + pending > 0
+                """
+            ).fetchall()
+            for row in rows:
+                event = db.execute(
+                    "SELECT MAX(created_at) AS last_event_at FROM task_events WHERE mission_id = ?",
+                    (row["mission_id"],),
+                ).fetchone()
+                stamps = [value for value in (row["last_task_at"], event["last_event_at"]) if value]
+                parsed = []
+                for value in stamps:
+                    try:
+                        parsed.append(datetime.fromisoformat(value))
+                    except ValueError:
+                        continue
+                if not parsed:
+                    continue
+                idle = (now - max(parsed)).total_seconds()
+                if idle >= idle_seconds:
+                    stalled.append(
+                        {
+                            "mission_id": row["mission_id"],
+                            "idle_seconds": idle,
+                            "running": int(row["running"]),
+                            "pending": int(row["pending"]),
+                        }
+                    )
+        return tuple(sorted(stalled, key=lambda item: -item["idle_seconds"]))
+
     def mission_status(self, mission_id: str) -> str:
         """Compute mission state from the latest durable planning phase."""
         tasks = self.list_tasks(mission_id)
