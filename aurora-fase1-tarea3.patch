--- a/aurora/external_monitor.py	1970-01-01 00:00:00.000000000 +0000
+++ b/aurora/external_monitor.py	2026-10-11 05:57:06.076007737 +0000
@@ -0,0 +1,128 @@
+"""Monitor externo: comprueba el endpoint de salud y avisa si Aurora no responde.
+
+Pensado para ejecutarse cada minuto desde un timer systemd (deploy/aurora-monitor.timer),
+como proceso independiente del daemon, para detectar tambien que el servicio este caido.
+
+    python -m aurora.external_monitor
+
+Variables: AURORA_MONITOR_URL, AURORA_DASHBOARD_API_TOKEN, AURORA_MONITOR_STATE,
+AURORA_MONITOR_FAILURES_BEFORE_ALERT (def. 2), AURORA_MONITOR_REALERT_SECONDS (def. 21600),
+AURORA_MONITOR_SYSTEMD_UNIT (opcional, p. ej. aurora.service),
+AURORA_MONITOR_USE_EGRESS_PROXY (def. 0: el monitor envia directo, porque el proxy puede estar caido).
+Canales: los mismos que el daemon (Telegram / webhook).
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import subprocess
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+from aurora.alerts import AlertManager, build_alert_manager_from_env
+
+logger = logging.getLogger("aurora.external_monitor")
+ALERT_KEY = "external:aurora-down"
+
+
+def probe_health(url: str, token: str | None, timeout: float = 10.0) -> tuple[bool, str]:
+    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"} if token else {})
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # nunca usar proxies del entorno
+    try:
+        with opener.open(request, timeout=timeout) as response:
+            body = response.read(2_000_000)
+            if response.status != 200:
+                return False, f"HTTP {response.status}"
+            json.loads(body.decode("utf-8"))
+            return True, "ok"
+    except urllib.error.HTTPError as exc:
+        return False, f"HTTP {exc.code}"
+    except json.JSONDecodeError:
+        return False, "respuesta de salud no es JSON valido"
+    except Exception as exc:
+        return False, f"{type(exc).__name__}: {str(exc)[:120]}"
+
+
+def probe_systemd_unit(unit: str) -> tuple[bool, str]:
+    try:
+        result = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True, timeout=10)
+    except Exception as exc:
+        return False, f"no se pudo consultar systemd: {type(exc).__name__}"
+    state = result.stdout.strip() or "unknown"
+    return state == "active", f"{unit} esta '{state}'"
+
+
+def run_check(
+    *,
+    probe: Callable[[], tuple[bool, str]],
+    alerts: AlertManager,
+    state_path: Path,
+    failures_before_alert: int = 2,
+    realert_seconds: float = 21600.0,
+    now: Callable[[], float] = time.time,
+) -> dict[str, Any]:
+    """Una ejecucion del monitor. El estado persiste en disco entre ejecuciones."""
+    try:
+        state = json.loads(state_path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        state = {}
+    failures = int(state.get("consecutive_failures", 0))
+    alerted_at = state.get("alerted_at")
+    ok, detail = probe()
+    if ok:
+        if alerted_at is not None:
+            alerts.resolve(ALERT_KEY, "Aurora ha vuelto a responder", f"tras {failures} comprobaciones fallidas", force=True)
+        state = {"consecutive_failures": 0, "alerted_at": None}
+    else:
+        failures += 1
+        due = alerted_at is None or now() - float(alerted_at) >= realert_seconds
+        if failures >= failures_before_alert and due:
+            alerts.notify(ALERT_KEY, "critical", "Aurora NO responde", f"{detail} ({failures} comprobaciones seguidas)", force=True)
+            alerted_at = now()
+        state = {"consecutive_failures": failures, "alerted_at": alerted_at, "last_detail": detail}
+    try:
+        state_path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = state_path.with_suffix(".tmp")
+        tmp.write_text(json.dumps(state), encoding="utf-8")
+        tmp.replace(state_path)
+    except OSError as exc:
+        logger.error("no se pudo guardar el estado del monitor: %s", exc)
+    alerts.flush(15.0)
+    return {"ok": ok, "detail": detail, **state}
+
+
+def main(env: Mapping[str, str] | None = None) -> int:
+    env = os.environ if env is None else env
+    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s")
+    port = env.get("AURORA_DASHBOARD_PORT", "8787")
+    url = env.get("AURORA_MONITOR_URL", f"http://127.0.0.1:{port}/api/dashboard/health")
+    token = env.get("AURORA_DASHBOARD_API_TOKEN") or None
+    unit = env.get("AURORA_MONITOR_SYSTEMD_UNIT", "").strip()
+    use_proxy = env.get("AURORA_MONITOR_USE_EGRESS_PROXY", "0").strip().lower() in {"1", "true", "yes"}
+    alerts = build_alert_manager_from_env(env, use_egress_proxy=use_proxy, asynchronous=False)
+
+    def probe() -> tuple[bool, str]:
+        if unit:
+            ok, detail = probe_systemd_unit(unit)
+            if not ok:
+                return False, detail
+        return probe_health(url, token)
+
+    workspace = env.get("AURORA_WORKSPACE_ROOT", ".aurora-runtime")
+    result = run_check(
+        probe=probe,
+        alerts=alerts,
+        state_path=Path(env.get("AURORA_MONITOR_STATE", f"{workspace}/monitor-state.json")),
+        failures_before_alert=max(1, int(env.get("AURORA_MONITOR_FAILURES_BEFORE_ALERT", "2") or 2)),
+        realert_seconds=float(env.get("AURORA_MONITOR_REALERT_SECONDS", "21600") or 21600),
+    )
+    logger.info("monitor: ok=%s detail=%s failures=%s", result["ok"], result["detail"], result.get("consecutive_failures"))
+    return 0 if result["ok"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff -ruN '--exclude=__pycache__' '--exclude=.pytest_cache' /tmp/p1/Aurora-main/aurora/health_monitor.py Aurora-main/aurora/health_monitor.py
--- a/aurora/health_monitor.py	1970-01-01 00:00:00.000000000 +0000
+++ b/aurora/health_monitor.py	2026-10-11 05:57:06.077273291 +0000
@@ -0,0 +1,199 @@
+"""Chequeos periodicos de salud del runtime 24/7 con alertas.
+
+Cada chequeo devuelve ``CheckResult``. Un chequeo debe fallar ``failures_before_alert``
+ciclos seguidos antes de alertar (evita falsas alarmas por picos) y avisa al recuperarse.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import shutil
+import socket
+import threading
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Callable, Sequence
+
+logger = logging.getLogger("aurora.health_monitor")
+
+
+@dataclass(frozen=True)
+class CheckResult:
+    ok: bool
+    detail: str = ""
+    severity: str = "critical"  # critical | warning
+
+
+@dataclass(frozen=True)
+class HealthCheck:
+    key: str
+    title: str
+    run: Callable[[], CheckResult]
+
+
+class HealthMonitor:
+    def __init__(
+        self,
+        checks: Sequence[HealthCheck],
+        alerts: Any,
+        *,
+        interval_seconds: float = 60.0,
+        failures_before_alert: int = 2,
+    ) -> None:
+        self.checks = list(checks)
+        self.alerts = alerts
+        self.interval_seconds = interval_seconds
+        self.failures_before_alert = max(1, failures_before_alert)
+        self._consecutive: dict[str, int] = {}
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+
+    def run_once(self) -> dict[str, CheckResult]:
+        results: dict[str, CheckResult] = {}
+        for check in self.checks:
+            try:
+                result = check.run()
+            except Exception as exc:  # un chequeo roto es en si un problema que alertar
+                result = CheckResult(False, f"el chequeo fallo: {type(exc).__name__}: {str(exc)[:150]}", "warning")
+            results[check.key] = result
+            if result.ok:
+                if self._consecutive.get(check.key, 0) >= self.failures_before_alert:
+                    self.alerts.resolve(f"health:{check.key}", f"{check.title}: recuperado", result.detail)
+                self._consecutive[check.key] = 0
+                continue
+            count = self._consecutive.get(check.key, 0) + 1
+            self._consecutive[check.key] = count
+            if count >= self.failures_before_alert:
+                self.alerts.notify(f"health:{check.key}", result.severity, check.title, result.detail)
+        return results
+
+    def start(self) -> None:
+        if self._thread is not None and self._thread.is_alive():
+            return
+        self._stop.clear()
+        self._thread = threading.Thread(target=self._loop, name="aurora-health-monitor", daemon=True)
+        self._thread.start()
+
+    def stop(self, timeout: float = 5.0) -> None:
+        self._stop.set()
+        if self._thread is not None:
+            self._thread.join(timeout)
+
+    def _loop(self) -> None:
+        while not self._stop.is_set():
+            try:
+                self.run_once()
+            except Exception:
+                logger.exception("health monitor cycle failed")
+            self._stop.wait(self.interval_seconds)
+
+
+# -- chequeos concretos ----------------------------------------------------
+
+def check_disk_usage(path: str | Path, threshold_percent: float = 80.0) -> CheckResult:
+    usage = shutil.disk_usage(str(path))
+    percent = usage.used / usage.total * 100.0
+    free_gb = usage.free / 1024**3
+    detail = f"{path}: {percent:.0f}% usado, {free_gb:.1f} GB libres"
+    return CheckResult(percent < threshold_percent, detail, "critical" if percent >= 95 else "warning")
+
+
+def check_egress_proxy(host: str, port: int, timeout: float = 3.0) -> CheckResult:
+    try:
+        with socket.create_connection((host, port), timeout=timeout):
+            return CheckResult(True, f"{host}:{port} responde")
+    except OSError as exc:
+        return CheckResult(False, f"proxy de salida {host}:{port} inaccesible ({type(exc).__name__})")
+
+
+def check_stalled_missions(store: Any, idle_seconds: float) -> CheckResult:
+    stalled = store.stalled_missions(idle_seconds=idle_seconds)
+    if not stalled:
+        return CheckResult(True, "sin misiones atascadas")
+    lines = [
+        f"{item['mission_id']}: {int(item['idle_seconds'] // 60)} min sin actividad "
+        f"({item['running']} en curso, {item['pending']} pendientes)"
+        for item in stalled[:5]
+    ]
+    extra = f" (+{len(stalled) - 5} mas)" if len(stalled) > 5 else ""
+    return CheckResult(False, "; ".join(lines) + extra, "warning")
+
+
+def enabled_models_from_policy(policy_path: str | Path) -> list[tuple[str, str]]:
+    policy = json.loads(Path(policy_path).read_text(encoding="utf-8"))
+    return [
+        (str(model.get("provider", "nvidia_api")), str(model["id"]))
+        for model in policy.get("models", [])
+        if model.get("enabled") is True
+    ]
+
+
+def check_models_available(
+    health_store: Any,
+    enabled_models: Callable[[], Sequence[tuple[str, str]]],
+    degraded_fraction: float = 0.5,
+) -> CheckResult:
+    """Critico si ningun modelo habilitado es enrutable; aviso si falla una fraccion alta."""
+    models = list(enabled_models())
+    if not models:
+        return CheckResult(False, "no hay ningun modelo habilitado en la politica de inferencia")
+    blocked: list[Any] = []
+    for provider_id, model_id in models:
+        snapshot = health_store.snapshot(provider_id, model_id)
+        if not snapshot.routable:
+            blocked.append(snapshot)
+    ok_count = len(models) - len(blocked)
+    codes: dict[str, int] = {}
+    for snapshot in blocked:
+        code = str(snapshot.last_error_code or snapshot.last_error_type or "?")
+        codes[code] = codes.get(code, 0) + 1
+    summary = ", ".join(f"{code} x{n}" for code, n in sorted(codes.items()))
+    detail = f"{ok_count}/{len(models)} modelos operativos" + (f"; errores: {summary}" if summary else "")
+    if ok_count == 0:
+        return CheckResult(False, "NINGUN modelo disponible. " + detail, "critical")
+    if len(blocked) / len(models) >= degraded_fraction:
+        return CheckResult(False, "muchos modelos caidos. " + detail, "warning")
+    return CheckResult(True, detail)
+
+
+def build_default_monitor(
+    *,
+    store: Any,
+    alerts: Any,
+    workspace_root: str | Path,
+    inference_policy_path: str | Path,
+    proxy_host: str | None,
+    proxy_port: int,
+    env: Any = None,
+) -> HealthMonitor:
+    """Monitor estandar del daemon: disco, proxy de salida, misiones atascadas y modelos."""
+    import os
+
+    env = os.environ if env is None else env
+    interval = float(env.get("AURORA_MONITOR_INTERVAL_SECONDS", "") or 60)
+    disk_percent = float(env.get("AURORA_DISK_ALERT_PERCENT", "") or 80)
+    stalled_seconds = float(env.get("AURORA_STALLED_MISSION_MINUTES", "") or 30) * 60.0
+    workspace = Path(workspace_root)
+
+    checks = [
+        HealthCheck("disk", "Disco casi lleno", lambda: check_disk_usage(workspace, disk_percent)),
+        HealthCheck("stalled_missions", "Misiones atascadas", lambda: check_stalled_missions(store, stalled_seconds)),
+    ]
+    if proxy_host:
+        checks.append(
+            HealthCheck("egress_proxy", "Proxy de salida inaccesible", lambda: check_egress_proxy(proxy_host, proxy_port))
+        )
+    try:
+        from aurora.inference.provider_health import ProviderHealthStore
+
+        health_store = ProviderHealthStore(workspace / "tasks.db")
+        checks.append(
+            HealthCheck(
+                "models",
+                "Modelos de inferencia no disponibles",
+                lambda: check_models_available(health_store, lambda: enabled_models_from_policy(inference_policy_path)),
+            )
+        )
+    except Exception:
+        logger.exception("model availability check disabled")
+    return HealthMonitor(checks, alerts, interval_seconds=interval)
