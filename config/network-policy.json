{
  "default": "deny",
  "protocols": ["https"],
  "allowed_hosts": [
    "github.com",
    "api.github.com",
    "pypi.org",
    "files.pythonhosted.org",
    "registry.npmjs.org",
    "archive.ubuntu.com",
    "security.ubuntu.com",
    "integrate.api.nvidia.com"
  ],
  "browser_isolation_required": true,
  "sandbox_network": "broker_only",
  "os_isolation": {
    "backend": "bubblewrap",
    "required": true,
    "unshare_net": true,
    "direct_network": false
  }
}
