{
  "default": "deny",
  "protocols": [
    "https"
  ],
  "allowed_hosts": [
    "api.anthropic.com",
    "api.github.com",
    "api.openai.com",
    "api.telegram.org",
    "archive.ubuntu.com",
    "build.nvidia.com",
    "files.pythonhosted.org",
    "generativelanguage.googleapis.com",
    "github.com",
    "integrate.api.nvidia.com",
    "openrouter.ai",
    "pypi.org",
    "registry.npmjs.org",
    "security.ubuntu.com",
    "smtp.gmail.com",
    "smtp.office365.com"
  ],
  "browser_isolation_required": true,
  "sandbox_network": "broker_only",
  "os_isolation": {
    "backend": "bubblewrap",
    "required": true,
    "unshare_net": true,
    "direct_network": false
  },
  "allowed_ports": [
    443,
    465
  ]
}
